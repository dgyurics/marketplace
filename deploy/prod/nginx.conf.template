# Hide nginx version
server_tokens off;

# Rate limiting
limit_req_zone $binary_remote_addr zone=users:1m       rate=50r/m;
limit_req_zone $binary_remote_addr zone=orders:1m      rate=10r/m;
limit_req_zone $binary_remote_addr zone=webhooks:1m    rate=1000r/m;
limit_req_zone $binary_remote_addr zone=api_general:1m rate=100r/m;
limit_req_zone $binary_remote_addr zone=img_proxy:1m   rate=500r/m;
limit_req_zone $binary_remote_addr zone=frontend:1m    rate=100r/m;
limit_req_status 429;

# Image cache
proxy_cache_path /var/cache/nginx/images
   levels=1:2
   keys_zone=images:10m
   max_size=2g
   inactive=30d
   use_temp_path=off;

upstream api_backend {
   server api:8000;
   keepalive 32;
}

upstream web_backend {
   server web:80;
   keepalive 16;
}

upstream imgproxy_backend {
   server imgproxy:80;
   keepalive 32;
}

# Only the explicitly configured upstream proxy may supply a client address.
set_real_ip_from ${MARKETPLACE_TRUSTED_PROXY};
real_ip_header X-Real-IP;

# Preserve HTTPS only when it was reported by the trusted proxy.
geo $realip_remote_addr $trusted_proxy {
   default 0;
   ${MARKETPLACE_TRUSTED_PROXY} 1;
}
map "$trusted_proxy:$http_x_forwarded_proto" $external_scheme {
   default $scheme;
   "1:https" https;
}

server {
   listen 80;
   server_name _;

   # Security headers
   add_header X-Content-Type-Options     "nosniff" always;
   add_header X-Frame-Options            "SAMEORIGIN" always;
   add_header Referrer-Policy            "strict-origin-when-cross-origin" always;

   # Proxy
   proxy_connect_timeout 5s;
   proxy_read_timeout    60s;
   proxy_send_timeout    60s;

   # Gzip
   gzip            on;
   gzip_vary       on;
   gzip_proxied    any;
   gzip_min_length 1024;
   gzip_comp_level 6;
   gzip_types
      text/javascript
      text/css
      text/plain
      application/javascript
      application/json;

   # API: users
   location ~ ^/api/users(/.*)?$ {
      proxy_set_header X-Forwarded-For   $remote_addr;
      proxy_set_header X-Forwarded-Proto $external_scheme;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;

      proxy_http_version                 1.1;
      proxy_set_header Connection        "";

      proxy_pass                         http://api_backend/users$1$is_args$args;
      limit_req                          zone=users burst=10 nodelay;
   }

   # API: orders
   location ~ ^/api/orders(/.*)?$ {
      proxy_set_header X-Forwarded-For   $remote_addr;
      proxy_set_header X-Forwarded-Proto $external_scheme;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;

      proxy_http_version                 1.1;
      proxy_set_header Connection        "";

      proxy_pass                         http://api_backend/orders$1$is_args$args;
      limit_req                          zone=orders burst=5 nodelay;
   }

   # API: stripe webhooks
   location /api/payment/events {
      proxy_set_header X-Forwarded-For   $remote_addr;
      proxy_set_header X-Forwarded-Proto $external_scheme;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;

      proxy_http_version                 1.1;
      proxy_set_header Connection        "";

      proxy_pass                         http://api_backend/payment/events;
      limit_req                          zone=webhooks burst=100 nodelay;
   }

   # API: image uploads (larger body)
   location /api/images/products/ {
      proxy_set_header X-Forwarded-For   $remote_addr;
      proxy_set_header X-Forwarded-Proto $external_scheme;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;

      proxy_http_version                 1.1;
      proxy_set_header Connection        "";

      proxy_pass                         http://api_backend/images/products/;
      client_max_body_size               30M;
   }

   # API: catch-all
   location /api/ {
      proxy_set_header X-Forwarded-For   $remote_addr;
      proxy_set_header X-Forwarded-Proto $external_scheme;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;

      proxy_http_version                 1.1;
      proxy_set_header Connection        "";

      proxy_pass                         http://api_backend/;
      client_max_body_size               512k;
      limit_req                          zone=api_general burst=20 nodelay;
   }

   # Image proxy (imgproxy) with caching
   location /images/ {
      proxy_set_header X-Forwarded-For   $remote_addr;
      proxy_set_header X-Forwarded-Proto $external_scheme;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;

      proxy_http_version                 1.1;
      proxy_set_header Connection        "";

      proxy_pass                         http://imgproxy_backend/;
      limit_req                          zone=img_proxy burst=100 nodelay;

      # Cache settings
      proxy_cache                        images;
      proxy_cache_valid 200              7d;
      proxy_cache_valid 404              5m;
      proxy_cache_valid 500 502 503 504  1m;
      proxy_cache_key                    $uri$is_args$args;
      proxy_cache_lock                   on;
      proxy_cache_lock_timeout           5s;
      proxy_cache_min_uses               1;
      proxy_cache_use_stale              error timeout invalid_header updating;

      add_header X-Cache-Status          $upstream_cache_status;
   }

   # Frontend (web container)
   location / {
      proxy_set_header X-Forwarded-For   $remote_addr;
      proxy_set_header X-Forwarded-Proto $external_scheme;
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;

      proxy_http_version                 1.1;
      proxy_set_header Connection        "";

      proxy_pass                         http://web_backend;
      limit_req                          zone=frontend burst=100 nodelay;
   }
}
